msgid "Slip 1 stitch purlwise with yarn in back"
msgstr "glisser 1 maille comme pour tricoter à l’envers, fil derrière"

msgid "Slip 1 stitch purlwise with yarn in front"
msgstr "glisser 1 maille comme pour tricoter à l’envers, fil devant"

msgid "Slip, slip, knit"
msgstr "glisser 2 mailles une à une, puis les tricoter ensemble à l’endroit"

msgid "yarn over"
msgstr "jeté"

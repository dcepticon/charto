msgid "k1, leaving stitch on left hand needle, yo, k1 into same stitch"
msgstr "лиц., не снимая петлю с левой спицы, накид, лиц. в ту же петлю"

msgid "Knit 2 together"
msgstr "2 лицевых вместе"

msgid "Knit 3 together"
msgstr "3 лицевых вместе"

msgid "knit front and back of same st"
msgstr "связать лиц. в переднюю, затем в заднюю стенку одной петли"


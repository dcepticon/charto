<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.charto.Charto</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Charto</name>
  <summary>Design knitting charts and patterns</summary>
  <developer id="org.charto">
    <name>Claude and Fibrely Designs</name>
  </developer>
  <description>
    <p>
      Charto is a knitting chart designer. Place stitch symbols on a grid, colour cells,
      repeat rows, number rows and stitches, and print or export the finished chart as an
      image or a vector drawing.
    </p>
    <p>
      It opens and saves sconcho pattern files (.spf). Charto is a port of sconcho, written
      in Rust with a Qt 6 interface.
    </p>
  </description>
  <url type="homepage">https://dcepticon.github.io/charto/</url>
  <url type="vcs-browser">https://github.com/dcepticon/charto</url>
  <url type="bugtracker">https://github.com/dcepticon/charto/issues</url>
  <launchable type="desktop-id">org.charto.Charto.desktop</launchable>
  <provides>
    <binary>charto</binary>
    <mediatype>application/x-charto-pattern</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="3.1.0" date="2026-10-13"/>
  </releases>
</component>
